generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  price       Float
  category    String
  img         String   @default("/images/placeholder.jpg")
  description String
  handcrafted Boolean  @default(true)
  material    String?
  isActive    Boolean  @default(true)
  featured    Boolean  @default(false)
  stock       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  OrderItem OrderItem[]

  @@index([category])
  @@index([isActive])
  @@index([featured])
}

model Order {
  id                   String      @id @default(cuid())
  items                OrderItem[]
  total                Float
  customerName         String
  customerEmail        String?
  customerPhone        String
  customerAddress      String
  customerCity         String
  customerInstructions String?
  status               String      @default("pending")
  paymentMethod        String      @default("Cash on Delivery")
  createdAt            DateTime    @default(now())

  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Float
  quantity  Int

  @@map("order_items")
}

model CustomOrder {
  id                String   @id @default(cuid())
  customerName      String
  customerEmail     String?
  customerPhone     String
  jewelryType       String
  description       String
  budget            String?
  timeline          String?
  inspirationImages String[] @default([])
  status            String   @default("pending")
  createdAt         DateTime @default(now())

  @@index([status])
  @@map("custom_orders")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admins")
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  imgUrl    String   @default("/images/placeholder.jpg")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}
